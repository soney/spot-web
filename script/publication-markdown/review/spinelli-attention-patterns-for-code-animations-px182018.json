      ],
      "sha256": "386431ab03189da4b82500dcba87a3911757f4df6c71661438da594a9fb7b8ea",
      "kind": "figure",
      "alt": "Interactive task screen with the Python program in an editor on the left. Run and Tasks controls appear on the right above instructions to debug the code and identify and fix its logic problem. The participant can edit and run the program to complete these tasks."
    },
    {
      "path": "figures/spinelli-attention-patterns-for-code-animations-px182018/figure-004-p003.png",
      "node": "432:0",
