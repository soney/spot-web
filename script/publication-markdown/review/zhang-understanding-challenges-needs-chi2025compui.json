  "assets": [
    {
      "path": "figures/zhang-understanding-challenges-needs-chi2025compui/figure-001-p004.png",
      "node": "959:0",
      "page": 4,
      "bbox": [
        51.79800033569336,
        81.68566131591797,
        560.186279296875,
        172.11399841308594
      ],
      "sha256": "93f6e326b59cc6700d512b91b7bb39b8b36ef7eef7ab4b9bd579125798cbda59",
      "kind": "figure",
      "alt": "Figure 1: Users first went through a screening survey (A) to collect demographic and technical background information. During the interview, participants were introduced to the web automation concepts and demonstrations through an overview session (B). Users were asked to propose 5–10 examples of web tasks they commonly perform (C). Then they evaluated each of these tasks and six predefined tasks through discussions of interaction, preferred automation levels, concerns, and usage frequency (D). This evaluation process was repeated for all scenarios (E). Participants then answered follow-up questions to explore additional use cases or concerns (F). After the interview, they completed a continuous survey over the next month to log additional tasks incrementally (G)."
    },
    {
      "path": "figures/zhang-understanding-challenges-needs-chi2025compui/figure-002-p005.png",
      "node": "1072:0",
      "page": 5,
      "bbox": [
        51.79800033569336,
        81.68468475341797,
        560.2103881835938,
        356.3089904785156
      ],
      "sha256": "1c4b2d73c32e5086a1658f6d4f1025820dd3a8c7368259e5e89cd455df519757",
      "kind": "figure",
      "alt": "Figure 2. Distribution of 150 user-defined tasks. Subjectivity: 56.2 percent partially subjective, 26.6 percent not subjective, 17.2 percent completely subjective. Initiative: 76.6 percent reactive, 13.8 percent proactive, 9.7 percent mixed. Repetition: 84.0 percent unpredictable, 15.4 percent predictable, 0.6 percent one-time. Information sensitivity: 59.8 percent low, 18.9 percent moderate, 8.9 percent high, 12.4 percent none. Communication: 76.3 percent none, 12.4 percent with known people, 11.2 percent with strangers. Context: 69.2 percent personal, 27.8 percent professional, 3.0 percent mixed."
    },
    {
      "path": "figures/zhang-understanding-challenges-needs-chi2025compui/figure-003-p005.png",
      "node": "1074:0",
      "page": 5,
      "bbox": [
        51.79800033569336,
        409.0960388183594,
        560.2083129882812,
        539.0399780273438
      ],
      "sha256": "44329cfdb36f716d25e955c637964c82423006cb8600246ec066d7d05590ec09",
      "kind": "figure",
      "alt": "Figure 3. Stacked bars compare six predefined tasks and user-defined tasks. Automation runs from 1, full automation, to 6, none; concern runs from 1, no concern, to 5, extreme concern. Full automation is most common for news summaries (59.1 percent) and market reports (50.0 percent); price comparison has 34.8 percent at automation level 5. Privacy has the clearest high-concern shares: rent payment has 42.1 percent extreme concern and 15.8 percent level 4; appointments have 30.0 percent extreme concern. For user-defined tasks, 34.8 percent favor full automation, while no-concern shares are 48.6 percent for errors, 64.5 percent for privacy, 52.9 percent for efficiency, and 66.7 percent for usefulness."
    }
  ],
