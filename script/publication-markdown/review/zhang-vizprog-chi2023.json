    {
      "path": "figures/zhang-vizprog-chi2023/formula-001-p008.png",
      "node": "911:0",
      "page": 8,
      "bbox": [
        315.8210754394531,
        601.7891845703125,
        563.0398559570312,
        650.52294921875
      ],
      "sha256": "cedcc6dbbead52141b475770c00c93a01e869229178ca3ec7adf2341a5eda211",
      "kind": "formula",
      "alt": "P is the matrix of code vectors vec of norm of p sub 1 through vec of norm of p sub n past. P belongs to the real matrices of size n past by 768."
    },
    {
      "path": "figures/zhang-vizprog-chi2023/formula-002-p009.png",
      "node": "921:0",
      "page": 9,
      "bbox": [
        60.126976013183594,
        264.80511474609375,
        287.6068420410156,
        314.031005859375
      ],
      "sha256": "15f964b6071f2385ca8e9a84d2d112fb16a019b392131eafbd4ce212d91b5bb1",
      "kind": "formula",
      "alt": "NEAR_APPROACH of c is the subset PC of correct past code, with n vec sim elements, that maximizes the sum over p in PC of vec_sim of c and p."
    },
    {
      "path": "figures/zhang-vizprog-chi2023/formula-003-p009.png",
      "node": "927:0",
      "page": 9,
      "bbox": [
        51.79800033569336,
        461.9578857421875,
        309.05084228515625,
        488.31207275390625
      ],
      "sha256": "220d316d5689772e43f3b390b78d5730808b2d3e55a0533cf89e274bb1f69f23",
      "kind": "formula",
      "alt": "y_position of c equals the sum over p sub n in NEAR_APPROACH of c of y tilde sub n multiplied by the softmax weight of vec_sim of c and p sub n cubed."
    },
    {
      "path": "figures/zhang-vizprog-chi2023/formula-004-p009.png",
      "node": "931:0",
      "page": 9,
      "bbox": [
        61.302001953125,
        618.8960571289062,
        284.8981018066406,
        643.3572387695312
      ],
      "sha256": "d22016c62dea9961268b76023e18571de94c5dd21d9624fc369560be03185f80",
      "kind": "formula",
      "alt": "edit_distance of c sub 1 and c sub 2 equals the Levenshtein distance between norm of c sub 1 and norm of c sub 2, divided by the larger length of those two normalized code strings."
    },
    {
      "path": "figures/zhang-vizprog-chi2023/formula-005-p009.png",
      "node": "935:0",
      "page": 9,
      "bbox": [
        315.84600830078125,
        166.0620574951172,
        564.450927734375,
        215.2879638671875
      ],
      "sha256": "a650b5ea165f55d2e55a8a3059c94a7f8248fdb42843ab285219103f9cbb7d6e",
      "kind": "formula",
      "alt": "NEAR_EDIT of c is the subset PC of correct past code, with n edit sim elements, that minimizes the sum over p in PC of edit_distance of c and p."
    },
    {
      "path": "figures/zhang-vizprog-chi2023/formula-006-p009.png",
      "node": "940:0",
      "page": 9,
      "bbox": [
        318.20599365234375,
        312.34210205078125,
        556.4822998046875,
        362.8408203125
      ],
      "sha256": "f5445ada1873651c46f81d434f28af0b28e121e526081b39e3046364adfdd200",
      "kind": "formula",
      "alt": "x_position of c equals zero if c is correct. Otherwise it is the arithmetic mean, over p in NEAR_EDIT of c, of minus edit_distance of c and p."
    },
    {
      "path": "figures/zhang-vizprog-chi2023/formula-007-p011.png",
      "node": "1078:0",
      "page": 11,
      "bbox": [
        316.58599853515625,
        244.54144287109375,
        584.3546752929688,
        268.8501281738281
      ],
      "sha256": "9801c1db9063bdca0741c01737ba31364da64bf95be09b629272cf21f1452c9d",
      "kind": "formula",
      "alt": "Quiz accuracy equals the number of matched answers divided by the maximum of the total number of correct answers and the total number of selected answers."
    }
