      ],
      "sha256": "7930e21f74015e95e8f6cefa0fefb64eb224be6985d7a34d94bb4c39143e01b6",
      "kind": "figure",
      "alt": "VizProg interface sketch: a spatial plot distinguishes correct and incorrect code and earlier versions; adjacent student and submission lists provide code details and search."
    },
    {
