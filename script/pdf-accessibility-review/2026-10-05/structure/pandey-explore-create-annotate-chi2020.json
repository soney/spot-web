  "figure_descriptions": [
    {
      "element": "505:0",
      "role": "Figure",
      "page": 1,
      "alt": "Figure 1. A participant’s tactile map of a park, drawn as raised outlines on transparent film. Several locations are marked with braille label strips and pieces of textured paper tape for audio labels, so the participant can distinguish the two label types by touch.",
      "actual_text": ""
    },
    {
      "element": "591:0",
      "role": "Figure",
      "page": 4,
      "alt": "This is a set of four images. Image 1 shows a map with braille labels and the associated key used in Task 1. Image 2 shows a map with audio labels used in Task 1. Image 3 shows the map used in Task 2. Image 4 shows tactile film and stylus used in Task 3. Collectively, the four images show the lightbox (apparatus) on which maps were placed and participants performing each of the three tasks.",
      "actual_text": ""
    },
    {
      "element": "669:0",
      "role": "Figure",
      "page": 9,
      "alt": "Five photographs of the non-drawing hand assisting tactile drawing. Stabilizing: palm and several fingers press the film flat. Anchoring: one index or middle finger marks the stylus start or end point. Finger splitting: one finger stays fixed while another separates to guide direction and curvature. Finger as a guide: an index finger lies flat so the stylus can trace against its edge. Stylus balancing: the stylus is held by the side of the dominant hand while that hand explores the drawing.",
      "actual_text": ""
    }
  ],
